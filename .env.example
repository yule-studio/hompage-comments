# Copy to .env and fill in. .env is gitignored — never commit the real token.
#
# Fine-grained personal access token scoped to THIS repository:
#   Repository permissions → Issues: Read and write
#   Repository permissions → Contents: Read and write   (only for image attachments)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

GITHUB_OWNER=yule-studio
GITHUB_REPO=hompage-comments
GITHUB_BRANCH=main
GITHUB_ATTACHMENTS=true

# Origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:5273,https://yule.studio

PORT=8080
