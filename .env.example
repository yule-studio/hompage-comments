# Copy to .env and fill in. .env is gitignored — never commit the real token.
#
# Fine-grained personal access token scoped to THIS repository:
#   Repository permissions → Issues: Read and write
#   Repository permissions → Contents: Read and write   (only for image attachments)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

GITHUB_OWNER=yule-studio
GITHUB_REPO=hompage-comments
GITHUB_BRANCH=main
GITHUB_ATTACHMENTS=true

# Origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:5273,https://yule.studio

# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For.
# Left false, the rate limit keys on the socket address instead.
TRUST_PROXY=false

PORT=8080


# ── resume-api ──────────────────────────────────────────────────────────
# The résumé as authored. This file must NOT be reachable from the public
# site — if the raw PDF is still downloadable, the masking is decoration.
RESUME_SOURCE=/absolute/path/to/resume.pdf

# Name the browser saves the masked copy under.
RESUME_FILENAME=오유찬_이력서.pdf

# Download log. Contains other people's names and emails — keep it off the
# public repo and out of backups you share.
RESUME_DB=./data/resume.db

# Empty → the built-in Korean phone-number pattern. Comma separated regexes.
RESUME_MASK_PATTERNS=

# Unset → GET /api/resume/downloads answers 404 instead of listing anything.
ADMIN_TOKEN=

# resume-api listens here; comment-api keeps PORT above.
RESUME_PORT=8081
